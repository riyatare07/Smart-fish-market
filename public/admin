<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login - Smart Fish Market</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #073b4c, #008fc2);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            width: 100%;
            max-width: 430px;
        }

        .login-card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
        }

        .logo {
            text-align: center;
            font-size: 42px;
            margin-bottom: 10px;
        }

        .title {
            text-align: center;
            color: #073b4c;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #718087;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #073b4c;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .form-group input {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #d5e1e5;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            transition: 0.25s;
        }

        .form-group input:focus {
            border-color: #008fc2;
            box-shadow: 0 0 0 3px rgba(0, 143, 194, 0.12);
        }

        .login-button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #008fc2;
            color: white;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.25s;
        }

        .login-button:hover {
            background: #073b4c;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 143, 194, 0.25);
        }

        .error-message {
            display: none;
            margin-top: 15px;
            padding: 12px;
            border-radius: 8px;
            background: #ffecec;
            color: #c62828;
            text-align: center;
            font-size: 14px;
        }

        .back-home {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #008fc2;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .back-home:hover {
            color: #073b4c;
        }

        .admin-badge {
            display: inline-block;
            background: #eaf8fc;
            color: #008fc2;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-top: 8px;
        }

        @media (max-width: 500px) {
            .login-card {
                padding: 30px 22px;
            }

            .title {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <div class="logo">🐟</div>

            <h1 class="title">Admin Login</h1>

            <p class="subtitle">
                Smart Fish Market
            </p>

            <div style="text-align: center;">
                <span class="admin-badge">
                    ADMINISTRATOR ACCESS
                </span>
            </div>

            <form id="adminLoginForm">

                <div class="form-group">
                    <label for="username">
                        Username
                    </label>

                    <input
                        type="text"
                        id="username"
                        placeholder="Enter admin username"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        placeholder="Enter admin password"
                        required
                    >
                </div>

                <button
                    type="submit"
                    class="login-button"
                >
                    🔐 Login to Dashboard
                </button>

            </form>

            <div
                id="errorMessage"
                class="error-message"
            >
                Invalid username or password.
            </div>

            <a
                href="index.html"
                class="back-home"
            >
                ← Back to Smart Fish Market
            </a>

        </div>

    </div>


    <script>

        document
            .getElementById("adminLoginForm")
            .addEventListener("submit", function(event) {

                event.preventDefault();

                const username =
                    document.getElementById("username").value.trim();

                const password =
                    document.getElementById("password").value;

                const errorMessage =
                    document.getElementById("errorMessage");


                /*
                    DEMO ADMIN CREDENTIALS

                    Username: admin
                    Password: admin123
                */

                if (
                    username === "admin" &&
                    password === "admin123"
                ) {

                    localStorage.setItem(
                        "adminLoggedIn",
                        "true"
                    );

                    window.location.href =
                        "admin-dashboard.html";

                } else {

                    errorMessage.style.display = "block";

                }

            });

    </script>

</body>
</html>
